# TradeBuddy server — systemd unit for Ubuntu 24.04 (AWS EC2).
# Install: sudo cp server/deploy/tradebuddy-server.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now tradebuddy-server
# Logs:    journalctl -u tradebuddy-server -f        (one JSON object per line)

[Unit]
Description=TradeBuddy server (NSE market monitor, read-only towards Upstox)
Documentation=file:///opt/tradebuddy/server/README.md
Wants=network-online.target
After=network-online.target
# give up after 10 failed starts in 5 minutes (e.g. a broken build); fix, then: systemctl reset-failed
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=tradebuddy
Group=tradebuddy
WorkingDirectory=/opt/tradebuddy
# secrets live here, never in the repository: chmod 640, owner root:tradebuddy
EnvironmentFile=/etc/tradebuddy/server.env
Environment=NODE_ENV=production
Environment=TZ=Asia/Kolkata
# the database lives in /var/lib/tradebuddy (passed to the server as STATE_DIRECTORY)
StateDirectory=tradebuddy
StateDirectoryMode=0700
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/dist/main.js
Restart=always
RestartSec=5
# exit code 78 = bad configuration: restarting would not help
RestartPreventExitStatus=78
KillSignal=SIGTERM
TimeoutStopSec=30

# hardening: the service can only write its own state directory
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1G

[Install]
WantedBy=multi-user.target
