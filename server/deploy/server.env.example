# TradeBuddy server settings — copy to /etc/tradebuddy/server.env and fill in.
#   sudo install -d -m 750 -o root -g tradebuddy /etc/tradebuddy
#   sudo install -m 640 -o root -g tradebuddy server/deploy/server.env.example /etc/tradebuddy/server.env
# NEVER commit the filled-in file. Restart after a change: sudo systemctl restart tradebuddy-server

# Where the server listens. Keep 127.0.0.1 and put Caddy / nginx (HTTPS) in front.
TB_HOST=127.0.0.1
TB_PORT=8787

# Token the Android app sends as "Authorization: Bearer <token>". At least 32 characters.
# Make one with:  openssl rand -hex 32
# Empty = the REST API is off (health checks still answer).
TB_API_TOKEN=

# Upstox Analytics Token (Upstox Developer Apps → Analytics). Read-only market data; valid one year.
# Empty = no prices, no live feed, no holiday list.
UPSTOX_ANALYTICS_TOKEN=

# Live price feed (WebSocket) during market hours: on / off.
TB_LIVE_FEED=on

# The app's own jobs on the server (scans, signals, alerts, learning, history downloads): on / off.
TB_JOBS=on

# Bulk history requests per rolling minute, shared by daily and 5-minute candles and corporate actions.
TB_HISTORICAL_REQUESTS_PER_MINUTE=30

# debug / info / warn / error
TB_LOG_LEVEL=info

# The database folder. Leave empty under systemd (it uses /var/lib/tradebuddy).
# TB_DATA_DIR=

# How long a graceful stop may take before the process exits anyway (systemd waits 30 s).
TB_SHUTDOWN_TIMEOUT_MS=20000
